# Local (.env.local): NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Vercel Production: NEXT_PUBLIC_SITE_URL=https://www.fortunaglobalholdings.com
#
# Supabase → Authentication → URL configuration
# Site URL: https://www.fortunaglobalholdings.com
# Redirect allow list:
#   https://www.fortunaglobalholdings.com/auth/update-password
#   http://localhost:3000/auth/update-password

# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only: required for admin invite, webhooks, workflow transitions
# service_role key (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# Canonical site URL for invite and email links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe — onboarding fee + usage invoices (sk_test_… until you go live)
STRIPE_SECRET_KEY=
# Local: secret printed by `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# Vercel: signing secret of the Dashboard endpoint
#   https://www.fortunaglobalholdings.com/api/webhooks/stripe
# Events: checkout.session.completed, invoice.paid, invoice.payment_failed, invoice.finalized
STRIPE_WEBHOOK_SECRET=

# Resend — transactional email (from-domain must be verified)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Fortuna Global Holdings <onboarding@fortunaglobalholdings.com>

# Twilio — SMS send + inbound replies
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+12187577721
# Vercel: https://www.fortunaglobalholdings.com/api/webhooks/twilio
# Local: leave blank, or an ngrok URL that forwards to /api/webhooks/twilio
TWILIO_WEBHOOK_URL=
# true only on localhost. Vercel Production must be false.
TWILIO_SKIP_SIGNATURE=false

# Dropbox Sign — per-client agreements. Leave CLIENT_ID empty (embedded signing breaks).
DROPBOX_SIGN_API_KEY=
DROPBOX_SIGN_TEMPLATE_ID=
DROPBOX_SIGN_CLIENT_ID=
DROPBOX_SIGN_FALLBACK_URL=https://app.hellosign.com/s/CdRr7SgF
DROPBOX_SIGN_TEST_MODE=true

# OpenAI — portal assistant (model is hardcoded to gpt-6-luna in code)
OPENAI_API_KEY=
# Optional pasted guide text until PDFs are published in Admin → Content
ASSISTANT_GUIDE_TEXT=

# Usage billing config (cents per round-turn lot; default 3000 = USD $30)
USAGE_FEE_PER_LOT_CENTS=3000

# Cron — Vercel calls /api/cron/reminders with Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
