# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only: required for admin invite, webhooks, workflow transitions
# https://app.supabase.com/project/_/settings/api — service_role key (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# Optional: canonical site URL for invite redirect links (defaults to request Origin)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe — onboarding fee + usage invoices
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend — transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL=Fortuna Global Holdings <onboarding@fortunaglobalholdings.com>

# Dropbox Sign — per-client agreements
DROPBOX_SIGN_API_KEY=
DROPBOX_SIGN_TEMPLATE_ID=
DROPBOX_SIGN_CLIENT_ID=
DROPBOX_SIGN_FALLBACK_URL=https://app.hellosign.com/s/CdRr7SgF
DROPBOX_SIGN_TEST_MODE=true

# OpenAI — guide-grounded assistant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional pasted guide text until PDF extraction is wired
ASSISTANT_GUIDE_TEXT=

# Usage billing config (cents per round-turn lot; default 3000 = USD $30)
USAGE_FEE_PER_LOT_CENTS=3000

# Cron — Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
